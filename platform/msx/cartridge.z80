;
; Conventional MSX cartridge header for the standalone BBC BASIC payload.

        TITLE   BBC BASIC MSX CARTRIDGE HEADER

        EXTRN   START
        EXTRN   EXTERR
        EXTRN   CASSSAVE
        EXTRN   CASSLOAD

        ASEG
        ORG     4000H

        DEFB    'A','B'
        DEFW    ENTRY
        DEFW    0
        DEFW    0
        DEFW    0
        DEFW    CASSSAVE     ;RAINBIOS STORAGE FALLBACK: SAVE
        DEFW    CASSLOAD     ;RAINBIOS STORAGE FALLBACK: LOAD
        DEFW    EXTERR          ;RAINBIOS STORAGE ERROR CALLBACK

ENTRY:  JP      START

FIN:    END
