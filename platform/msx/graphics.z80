; SPDX-License-Identifier: BSD-3-Clause
;
; BBC BASIC graphics adapter for the TMS9918 Graphics II screen.
;
; BBC logical coordinates (0..1279, 0..1023, origin at bottom left) are
; scaled to the 256x192 MSX display. The initial raster operations use one
; foreground colour over black in each TMS9918 eight-pixel colour cell.

        TITLE   BBC BASIC MSX GRAPHICS ADAPTER

        EXTRN   XEQ
        EXTRN   EXTERR
        EXTRN   EXPRI
        EXTRN   COMMA
        EXTRN   BRAKET

        EXTRN   GRAPHX
        EXTRN   GRAPHY
        EXTRN   GRAPHCOLOUR
        EXTRN   TARGETX
        EXTRN   TARGETY
        EXTRN   DELTAX
        EXTRN   DELTAY
        EXTRN   STEPX
        EXTRN   STEPY
        EXTRN   LINEERR
        EXTRN   PREVX
        EXTRN   PREVY
        EXTRN   PLOTMOD
        EXTRN   PIXELMODE
        EXTRN   DOTMODE
        EXTRN   DOTPHASE
        EXTRN   TRIX0
        EXTRN   TRIY0
        EXTRN   TRIX1
        EXTRN   TRIY1
        EXTRN   TRIX2
        EXTRN   TRIY2
        EXTRN   TRIXA
        EXTRN   TRIXB
        EXTRN   TRISA
        EXTRN   TRISA2
        EXTRN   TRISB
        EXTRN   TRISCAN
        EXTRN   TRITOP
        EXTRN   SOUNDREG

        GLOBAL  CLG
        GLOBAL  COLOUR
        GLOBAL  DRAW
        GLOBAL  ENVEL
        GLOBAL  GCOL
        GLOBAL  MODE
        GLOBAL  MOVE
        GLOBAL  PLOT
        GLOBAL  SOUND
        GLOBAL  ADVAL
        GLOBAL  POINT
        GLOBAL  GETIMS
        GLOBAL  PUTIMS

; Published MSX BIOS entry points and work-area state.
RDVRM   EQU     004AH
WRTVRM  EQU     004DH
FILVRM  EQU     0056H
INITXT  EQU     006CH
INITGRP EQU     0072H
SCRMOD  EQU     0FCAFH

; MODE 2 selects Graphics II. MODE 7 returns to the 40-column text screen.
MODE:   CALL    EXPRI
        EXX
        LD      A,H
        OR      A
        JR      NZ,GRAPHERR
        LD      A,L
        CP      2
        JR      Z,MODE2
        CP      7
        JP      NZ,GRAPHERR
        CALL    INITXT
        JP      XEQ
MODE2:  CALL    INITGRP
        CALL    RESETGRAPH
        JP      XEQ

; Clear the Graphics II bitmap and reset the graphics cursor to BBC (0,0).
CLG:    LD      A,(SCRMOD)
        CP      2
        CALL    NZ,INITGRP
        CALL    CLEARGRAPH
        JP      XEQ

CLEARGRAPH:
        LD      HL,0000H
        LD      BC,1800H
        XOR     A
        CALL    FILVRM
        LD      HL,2000H
        LD      BC,1800H
        LD      A,(GRAPHCOLOUR)
        AND     0FH
        RLCA
        RLCA
        RLCA
        RLCA
        OR      1
        CALL    FILVRM
RESETGRAPH:
        XOR     A
        LD      (GRAPHX),A
        LD      (PREVX),A
        LD      A,191
        LD      (GRAPHY),A
        LD      (PREVY),A
        RET

; GCOL 0,c selects a BBC solid foreground colour. Logical colours 0..7 map
; to the nearest stable TMS9918 palette entries; raster actions follow later.
GCOL:   CALL    EXPRI
        EXX
        PUSH    HL
        CALL    COMMA
        CALL    EXPRI
        EXX
        LD      A,H
        OR      A
        JR      NZ,GRAPHERRPOP
        LD      A,L
        AND     7
        LD      E,A
        LD      D,0
        LD      HL,COLOURMAP
        ADD     HL,DE
        LD      A,(HL)
        LD      (GRAPHCOLOUR),A
        POP     HL
        LD      A,H
        OR      L
        JR      NZ,GRAPHERR
        JP      XEQ

GRAPHERRPOP:
        POP     HL
GRAPHERR:
        XOR     A
        CALL    EXTERR
        DEFM    'Unsupported graphics operation'
        DEFB    0

COLOURMAP:
        DEFB    1,8,3,11,5,13,7,15

; MOVE and DRAW accept BBC logical coordinates and update the graphics cursor.
MOVE:   CALL    PARSEXY
        JR      C,COORDERR
MOVEPHYSICAL:
        XOR     A
        LD      (PIXELMODE),A
        LD      (DOTMODE),A
        LD      A,(GRAPHX)
        LD      (PREVX),A
        LD      A,(GRAPHY)
        LD      (PREVY),A
        LD      A,B
        LD      (GRAPHX),A
        LD      A,C
        LD      (GRAPHY),A
        JP      XEQ

DRAW:   CALL    PARSEXY
        JR      C,COORDERR
        XOR     A
        LD      (PIXELMODE),A
        LD      (DOTMODE),A
        LD      A,(GRAPHX)
        LD      (PREVX),A
        LD      A,(GRAPHY)
        LD      (PREVY),A
        CALL    DRAWTO
        JP      XEQ

COORDERR:
        XOR     A
        CALL    EXTERR
        DEFM    'Graphics coordinate outside screen'
        DEFB    0

; PLOT <mode>,<x>,<y> implements the BBC line, point, and triangle groups.
; Each group uses colour code mode&3 (0 move, 1 foreground, 2 inverse,
; 3 background) and mode bit 2 for relative versus absolute coordinates.
;  0-63   lines; solid in 0-15, dotted in 16-31, dash styles 32-63 render
;         dotted in this milestone;
;  64-79  single points;
;  80-95  filled triangles using the two most recently visited points;
;  96+    rectangles, fills, circles, and ellipses fail explicitly.
PLOT:   CALL    EXPRI
        EXX
        PUSH    HL
        CALL    COMMA
        LD      HL,0
        ADD     HL,SP
        LD      A,(HL)          ;PEEK THE PLOT MODE BEFORE THE COORDINATES
        LD      (PLOTMOD),A
        BIT     2,A
        JR      NZ,PLOTABSPARSE
PLOTRELPARSE:
        CALL    PARSEXYREL
        JR      C,PLOTCOORDERR
        JR      PLOTGOT
PLOTABSPARSE:
        CALL    PARSEXY
        JR      C,PLOTCOORDERR
PLOTGOT:
        POP     HL
        LD      A,H
        OR      A
        JP      NZ,GRAPHERR
        LD      A,L
        CP      96
        JP      NC,GRAPHERR
        LD      A,B
        LD      (TARGETX),A
        LD      A,C
        LD      (TARGETY),A
        LD      A,L
        CP      64
        JR      C,PLOTLINE
        CP      80
        JR      C,PLOTPOINT
        JP      PLOTTRI
PLOTCOORDERR:
        POP     HL
        JR      COORDERR

; Line modes 0-63. Colour 0 is a pure move; otherwise draw from the current
; graphics cursor to the target.
PLOTLINE:
        LD      A,(PLOTMOD)
        LD      C,A
        BIT     4,A
        JR      Z,PLOTLINESOLID
        LD      A,1
        LD      (DOTMODE),A
        LD      A,1
        LD      (DOTPHASE),A
        JR      PLOTLINEPIX
PLOTLINESOLID:
        XOR     A
        LD      (DOTMODE),A
PLOTLINEPIX:
        LD      A,C
        AND     3
        JR      Z,PLOTMOVELINE
        CALL    SETPIXMODE
        LD      A,(GRAPHX)
        LD      (PREVX),A
        LD      A,(GRAPHY)
        LD      (PREVY),A
        LD      A,(TARGETX)
        LD      B,A
        LD      A,(TARGETY)
        LD      C,A
        CALL    DRAWTO
        JP      XEQ
PLOTMOVELINE:
        LD      A,(GRAPHX)
        LD      (PREVX),A
        LD      A,(GRAPHY)
        LD      (PREVY),A
        LD      A,(TARGETX)
        LD      (GRAPHX),A
        LD      A,(TARGETY)
        LD      (GRAPHY),A
        JP      XEQ

; Point modes 64-79. The visited-point history advances and one pixel is
; written for colours other than zero.
PLOTPOINT:
        LD      A,(PLOTMOD)
        LD      C,A
        AND     3
        JR      Z,PLOTPOINTMOVE
        CALL    SETPIXMODE
PLOTPOINTMOVE:
        LD      A,(GRAPHX)
        LD      (PREVX),A
        LD      A,(GRAPHY)
        LD      (PREVY),A
        LD      A,(TARGETX)
        LD      (GRAPHX),A
        LD      A,(TARGETY)
        LD      (GRAPHY),A
        LD      A,C
        AND     3
        JR      Z,PLOTPOINTDONE
        CALL    PIXELAT
PLOTPOINTDONE:
        JP      XEQ

; Triangle modes 80-95 fill the triangle formed by the two most recently
; visited points and the target, then advance the cursor history.
PLOTTRI:
        LD      A,(PLOTMOD)
        AND     3
        JR      Z,PLOTTRIEND
        CALL    SETPIXMODE
        CALL    FILLTRIANGLE
PLOTTRIEND:
        LD      A,(GRAPHX)
        LD      (PREVX),A
        LD      A,(GRAPHY)
        LD      (PREVY),A
        LD      A,(TARGETX)
        LD      (GRAPHX),A
        LD      A,(TARGETY)
        LD      (GRAPHY),A
        JP      XEQ

; POINT(x,y) returns the TMS9918 colour at a BBC logical coordinate, or -1
; when the coordinate is outside the logical screen.
POINT:  CALL    PARSEXY
        PUSH    AF
        CALL    BRAKET
        POP     AF
        JR      C,POINTOFF
        CALL    READPIXEL
        LD      E,A
        LD      HL,COLOURMAP
        LD      B,0
POINTMAP:
        LD      A,(HL)
        CP      E
        JR      Z,POINTMAPPED
        INC     HL
        INC     B
        LD      A,B
        CP      8
        JR      NZ,POINTMAP
        LD      B,0
POINTMAPPED:
        LD      A,B
        LD      L,A
        LD      H,0
        EXX
        XOR     A
        LD      H,A
        LD      L,A
        LD      C,A
        RET
POINTOFF:
        LD      HL,-1
        EXX
        LD      HL,-1
        XOR     A
        LD      C,A
        RET

; Parse two comma-separated integer expressions and scale them from the BBC
; 1280x1024 logical grid to physical B=x (0..255), C=y (0..191).
PARSEXY:
        CALL    EXPRI
        EXX
        PUSH    HL
        CALL    COMMA
        CALL    EXPRI
        EXX
        EX      DE,HL
        POP     HL
        BIT     7,H
        JR      NZ,MAPBAD
        LD      A,H
        CP      5
        JR      NC,MAPBAD
        BIT     7,D
        JR      NZ,MAPBAD
        LD      A,D
        CP      4
        JR      NC,MAPBAD

        PUSH    DE
        LD      DE,5
        LD      C,0
MAPX:   OR      A
        SBC     HL,DE
        JR      C,MAPXDONE
        INC     C
        JR      MAPX
MAPXDONE:
        LD      B,C
        POP     DE

        LD      H,D
        LD      L,E
        ADD     HL,HL
        ADD     HL,DE
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      A,191
        SUB     L
        LD      C,A
        OR      A
        RET
MAPBAD: SCF
        RET

; Parse two comma-separated signed integer expressions as a displacement from
; the current graphics cursor, scaled from the BBC 1280x1024 logical grid.
; Output: B = target x (0..255), C = target y (0..191), carry set if either
; target leaves the display.
PARSEXYREL:
        CALL    EXPRI
        EXX
        PUSH    HL
        CALL    COMMA
        CALL    EXPRI
        EXX
        EX      DE,HL
        POP     HL
        PUSH    DE              ;HL = SIGNED X DELTA
        CALL    DELTADIV5       ;HL = X/5
        POP     DE              ;DE = SIGNED Y DELTA
        JR      C,PXYRBAD
        LD      A,(GRAPHX)
        LD      C,A
        LD      B,0
        ADD     HL,BC           ;TARGET X IN 0..255
        LD      A,H
        OR      A
        JR      NZ,PXYRBAD
        LD      B,L
        BIT     7,D
        JR      Z,PXYRYPOS
        XOR     A               ;Y NEGATIVE: DELTA IS POSITIVE DOWN
        SUB     E
        LD      E,A
        LD      A,0
        SBC     A,D
        LD      D,A
        PUSH    BC
        CALL    DELTASCALEY     ;HL = |Y|*3/16
        POP     BC
        JR      C,PXYRBAD
        JR      PXYRADD
PXYRYPOS:
        PUSH    BC
        CALL    DELTASCALEY     ;HL = Y*3/16
        POP     BC
        JR      C,PXYRBAD
        XOR     A               ;Y POSITIVE: DELTA IS NEGATIVE UP
        SUB     L
        LD      L,A
        LD      A,0
        SBC     A,H
        LD      H,A
PXYRADD:
        PUSH    BC              ;SAVE TARGET X (B)
        LD      A,(GRAPHY)
        LD      C,A
        LD      B,0
        ADD     HL,BC           ;TARGET Y IN 0..191
        LD      A,H
        OR      A
        JR      NZ,PXYRADDX
        LD      A,L
        CP      192
        JR      NC,PXYRADDX
        POP     DE              ;D = TARGET X
        LD      C,A             ;C = TARGET Y
        LD      B,D             ;B = TARGET X
        OR      A
        RET
PXYRADDX:
        POP     BC
PXYRBAD: SCF
        RET

; Signed 16-bit HL divided by 5, truncated toward zero. Carry if the quotient
; cannot fit in -255..255. Returns the quotient in HL.
DELTADIV5:
        BIT     7,H
        JR      Z,DIV5U
        XOR     A
        SUB     L
        LD      L,A
        LD      A,0
        SBC     A,H
        LD      H,A
        CALL    DIV5U
        JR      C,DIV5BAD
        XOR     A
        SUB     L
        LD      L,A
        LD      A,0
        SBC     A,H
        LD      H,A
        OR      A
        RET
DIV5BAD:
        SCF
        RET
DIV5U:  LD      A,H
        CP      5
        JR      NC,DIV5BAD
        LD      C,0
        LD      DE,5
DIV5ULOOP:
        OR      A
        SBC     HL,DE
        JR      C,DIV5UDONE
        INC     C
        JR      DIV5ULOOP
DIV5UDONE:
        LD      H,0
        LD      L,C
        OR      A
        RET

; Positive 16-bit DE scaled by 3/16. Carry if the result exceeds 191.
; Returns the scaled value in HL.
DELTASCALEY:
        LD      A,D
        CP      4
        JR      NC,DSCALEBAD
        LD      H,D
        LD      L,E
        ADD     HL,HL
        ADD     HL,DE
        XOR     A
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        SRL     H
        RR      L
        LD      A,L
        CP      192
        JR      NC,DSCALEBAD
        OR      A
        RET
DSCALEBAD:
        SCF
        RET

; Convert a BBC colour code 0-3 into PIXELMODE: 0 foreground set, 1 inverse
; (XOR), 2 background clear. Colour zero means move only and sets no mode.
SETPIXMODE:
        CP      3
        JR      Z,SETPIXCLEAR
        CP      2
        JR      Z,SETPIXXOR
        XOR     A
        LD      (PIXELMODE),A
        RET
SETPIXXOR:
        LD      A,1
        LD      (PIXELMODE),A
        RET
SETPIXCLEAR:
        LD      A,2
        LD      (PIXELMODE),A
        RET

; Eight-bit Bresenham line rasterizer. All persistent values live in the
; adapter's RAM state because BIOS VRAM calls may change working registers.
DRAWTO: LD      A,B
        LD      (TARGETX),A
        LD      A,C
        LD      (TARGETY),A

        LD      A,(GRAPHX)
        LD      D,A
        LD      A,B
        SUB     D
        JR      NC,DXPOS
        NEG
        LD      D,0FFH
        JR      DXSTORE
DXPOS:  LD      D,1
DXSTORE:
        LD      (DELTAX),A
        LD      A,D
        LD      (STEPX),A

        LD      A,(GRAPHY)
        LD      D,A
        LD      A,C
        SUB     D
        JR      NC,DYPOS
        NEG
        LD      D,0FFH
        JR      DYSTORE
DYPOS:  LD      D,1
DYSTORE:
        LD      (DELTAY),A
        LD      A,D
        LD      (STEPY),A

        LD      A,(DELTAY)
        LD      D,A
        LD      A,(DELTAX)
        CP      D
        JR      C,YMAJOR

        SRL     A
        LD      (LINEERR),A
XLINE:  CALL    DRAWPIXEL
        CALL    LINEATEND
        RET     Z
        LD      A,(GRAPHX)
        LD      D,A
        LD      A,(STEPX)
        ADD     A,D
        LD      (GRAPHX),A
        LD      A,(LINEERR)
        LD      D,A
        LD      A,(DELTAY)
        LD      E,A
        LD      A,D
        SUB     E
        JR      NC,XERRSTORE
        LD      D,A
        LD      A,(DELTAX)
        ADD     A,D
        LD      D,A
        LD      A,(GRAPHY)
        LD      E,A
        LD      A,(STEPY)
        ADD     A,E
        LD      (GRAPHY),A
        LD      A,D
XERRSTORE:
        LD      (LINEERR),A
        JR      XLINE

YMAJOR: LD      A,D
        SRL     A
        LD      (LINEERR),A
YLINE:  CALL    DRAWPIXEL
        CALL    LINEATEND
        RET     Z
        LD      A,(GRAPHY)
        LD      D,A
        LD      A,(STEPY)
        ADD     A,D
        LD      (GRAPHY),A
        LD      A,(LINEERR)
        LD      D,A
        LD      A,(DELTAX)
        LD      E,A
        LD      A,D
        SUB     E
        JR      NC,YERRSTORE
        LD      D,A
        LD      A,(DELTAY)
        ADD     A,D
        LD      D,A
        LD      A,(GRAPHX)
        LD      E,A
        LD      A,(STEPX)
        ADD     A,E
        LD      (GRAPHX),A
        LD      A,D
YERRSTORE:
        LD      (LINEERR),A
        JR      YLINE

LINEATEND:
        LD      A,(GRAPHX)
        LD      D,A
        LD      A,(TARGETX)
        CP      D
        RET     NZ
        LD      A,(GRAPHY)
        LD      D,A
        LD      A,(TARGETY)
        CP      D
        RET

; Write the pixel at the current graphics cursor. Dotted lines draw every
; other pixel and leave the other positions unwritten.
DRAWPIXEL:
        LD      A,(DOTMODE)
        OR      A
        JR      Z,PIXELAT
        LD      A,(DOTPHASE)
        XOR     1
        LD      (DOTPHASE),A
        JR      NZ,PIXELAT
        RET
PIXELAT:
        LD      A,(GRAPHX)
        LD      B,A
        LD      A,(GRAPHY)
        LD      C,A

; Write one physical pixel at B=x, C=y, honouring PIXELMODE.
FILLPIXEL:
        LD      A,(GRAPHCOLOUR)
        LD      E,A
        LD      A,(PIXELMODE)
        CP      1
        JR      Z,XORPIXEL
        CP      2
        JR      Z,CLRPIXEL

; Set one physical pixel. Each touched colour cell is assigned E over black.
SETPIXEL:
        LD      A,E
        PUSH    AF
        CALL    PIXELADDRESS
        LD      D,A
        PUSH    HL
        PUSH    HL
        CALL    RDVRM
        OR      D
        JR      PIXELWRITE

; Invert one physical pixel: set it in the foreground or clear it when the
; cell already holds the foreground colour.
XORPIXEL:
        LD      A,E
        PUSH    AF
        CALL    PIXELADDRESS
        LD      D,A
        PUSH    HL
        PUSH    HL
        CALL    RDVRM
        XOR     D
        JR      PIXELWRITE

; Clear one physical pixel to the background.
CLRPIXEL:
        LD      A,E
        PUSH    AF
        CALL    PIXELADDRESS
        LD      D,A
        PUSH    HL
        PUSH    HL
        CALL    RDVRM
        CPL
        AND     D
PIXELWRITE:
        POP     HL
        CALL    WRTVRM
        POP     HL
        LD      DE,2000H
        ADD     HL,DE
        POP     AF
        AND     0FH
        RLCA
        RLCA
        RLCA
        RLCA
        OR      1
        JP      WRTVRM

; Read the foreground or background colour selected by one physical pixel.
READPIXEL:
        CALL    PIXELADDRESS
        LD      D,A
        PUSH    HL
        CALL    RDVRM
        AND     D
        LD      E,0
        JR      Z,READCOLOUR
        INC     E
READCOLOUR:
        POP     HL
        LD      BC,2000H
        ADD     HL,BC
        CALL    RDVRM
        DEC     E
        JR      NZ,READBACKGROUND
        AND     0F0H
        RRCA
        RRCA
        RRCA
        RRCA
        RET
READBACKGROUND:
        AND     0FH
        RET

; Graphics II byte address and bit mask for physical B=x, C=y. The upper five
; Y bits select the tile row, the upper five X bits select its eight-byte
; pattern, and the low three Y bits select the pattern scanline.
PIXELADDRESS:
        LD      A,B
        AND     7
        LD      D,A
        LD      A,80H
PIXELMASK:
        DEC     D
        BIT     7,D
        JR      NZ,PIXELROW
        RRCA
        JR      PIXELMASK
PIXELROW:
        PUSH    AF
        LD      A,C
        AND     0F8H
        LD      L,A
        LD      H,0
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        LD      A,B
        AND     0F8H
        LD      E,A
        LD      D,0
        ADD     HL,DE
        LD      A,C
        AND     7
        LD      E,A
        LD      D,0
        ADD     HL,DE
        POP     AF
        RET

; Fill the triangle with vertices P1=(PREVX,PREVY), P2=(GRAPHX,GRAPHY) and
; P3=(TARGETX,TARGETY) using PIXELMODE. The three vertices are sorted by scan
; line and the horizontal span between two walked edges is filled for each
; scan line.
FILLTRIANGLE:
        LD      A,(PREVX)
        LD      (TRIX0),A
        LD      A,(PREVY)
        LD      (TRIY0),A
        LD      A,(GRAPHX)
        LD      (TRIX1),A
        LD      A,(GRAPHY)
        LD      (TRIY1),A
        LD      A,(TARGETX)
        LD      (TRIX2),A
        LD      A,(TARGETY)
        LD      (TRIY2),A
        LD      A,(TRIY0)
        LD      B,A
        LD      A,(TRIY1)
        CP      B
        JR      NC,FILLSORT2
        CALL    FILLSWAP01
FILLSORT2:
        LD      A,(TRIY1)
        LD      B,A
        LD      A,(TRIY2)
        CP      B
        JR      NC,FILLSORT3
        CALL    FILLSWAP12
FILLSORT3:
        LD      A,(TRIY0)
        LD      B,A
        LD      A,(TRIY1)
        CP      B
        JR      NC,FILLSORTED
        CALL    FILLSWAP01
FILLSORTED:
        LD      A,(TRIY2)
        LD      B,A
        LD      A,(TRIY0)
        SUB     B
        JP      Z,FILLHORIZ
        LD      A,B
        SUB     (TRIY0)         ;A = Y2-Y0
        LD      E,A
        LD      A,(TRIX2)
        LD      B,A
        LD      A,(TRIX0)
        SUB     B
        NEG                     ;A = X2-X0
        LD      D,A
        CALL    FIXSLOPE
        LD      (TRISB),HL
        LD      A,(TRIY1)
        LD      B,A
        LD      A,(TRIY0)
        SUB     B
        JR      NZ,FILLTOPEDGE
        LD      A,(TRIX1)       ;Y1 = Y0: START ON THE BOTTOM EDGE
        LD      H,A
        LD      L,0
        LD      (TRIXA),HL
        JR      FILLBOTTOMEDGE
FILLTOPEDGE:
        LD      A,B             ;B = Y1
        LD      C,A
        LD      A,(TRIY0)
        LD      E,A
        SUB     C
        NEG                     ;A = Y1-Y0
        LD      E,A
        LD      A,(TRIX1)
        LD      B,A
        LD      A,(TRIX0)
        SUB     B
        NEG                     ;A = X1-X0
        LD      D,A
        CALL    FIXSLOPE
        LD      (TRISA),HL
        LD      A,(TRIX0)
        LD      H,A
        LD      L,0
        LD      (TRIXA),HL
FILLBOTTOMEDGE:
        LD      A,(TRIY2)
        LD      B,A
        LD      A,(TRIY1)
        SUB     B
        JR      Z,FILLBOTTOMZERO
        LD      A,B             ;B = Y2
        LD      C,A
        LD      A,(TRIY1)
        LD      E,A
        SUB     C
        NEG                     ;A = Y2-Y1
        LD      E,A
        LD      A,(TRIX2)
        LD      B,A
        LD      A,(TRIX1)
        SUB     B
        NEG                     ;A = X2-X1
        LD      D,A
        CALL    FIXSLOPE
        LD      (TRISA2),HL
        JR      FILLINIT
FILLBOTTOMZERO:
        LD      HL,0
        LD      (TRISA2),HL
FILLINIT:
        LD      A,(TRIX0)
        LD      H,A
        LD      L,0
        LD      (TRIXB),HL
        LD      A,(TRIY0)
        LD      (TRISCAN),A
        LD      A,(TRIY1)
        LD      (TRITOP),A
FILLLOOP:
        LD      A,(TRISCAN)
        LD      C,A
        CALL    FILLSPAN
        LD      A,(TRISCAN)
        LD      B,A
        LD      A,(TRITOP)
        CP      B
        JR      NZ,FILLSTEP
        LD      A,(TRIX1)       ;PASS THE MIDDLE VERTEX: WALK THE BOTTOM EDGE
        LD      H,A
        LD      L,0
        LD      (TRIXA),HL
        LD      HL,(TRISA2)
        LD      (TRISA),HL
FILLSTEP:
        LD      A,(TRISCAN)
        INC     A
        LD      (TRISCAN),A
        LD      B,A
        LD      A,(TRIY2)
        CP      B
        JR      C,FILLDONE
        LD      HL,(TRISA)
        LD      DE,(TRIXA)
        ADD     HL,DE
        LD      (TRIXA),HL
        LD      HL,(TRISB)
        LD      DE,(TRIXB)
        ADD     HL,DE
        LD      (TRIXB),HL
        JR      FILLLOOP
FILLDONE:
        RET
FILLHORIZ1:
        JP      FILLHORIZ

; Degenerate flat triangle: fill the x span across all three vertices at y0.
FILLHORIZ:
        LD      A,(TRIX0)
        LD      B,A
        LD      A,(TRIX1)
        LD      C,A
        LD      A,(TRIX2)
        LD      D,B
        LD      E,C
        CP      D
        JR      NC,FILLHORIZMIN
        LD      D,A
FILLHORIZMIN:
        CP      E
        JR      C,FILLHORIZEND
        LD      E,A
FILLHORIZEND:
        LD      B,D
        LD      C,E
        LD      A,(TRIY0)
        LD      E,A
        JR      FILLRANGE

FILLSWAP01:
        LD      A,(TRIX0)
        LD      B,A
        LD      A,(TRIX1)
        LD      (TRIX0),A
        LD      A,B
        LD      (TRIX1),A
        LD      A,(TRIY0)
        LD      B,A
        LD      A,(TRIY1)
        LD      (TRIY0),A
        LD      A,B
        LD      (TRIY1),A
        RET
FILLSWAP12:
        LD      A,(TRIX1)
        LD      B,A
        LD      A,(TRIX2)
        LD      (TRIX1),A
        LD      A,B
        LD      (TRIX2),A
        LD      A,(TRIY1)
        LD      B,A
        LD      A,(TRIY2)
        LD      (TRIY1),A
        LD      A,B
        LD      (TRIY2),A
        RET

; Fill the horizontal span between the fixed-point edge positions TRIXA and
; TRIXB at scanline C, clipped to the 0..255 display.
FILLSPAN:
        LD      E,C
        LD      A,(TRIXA+1)
        LD      B,A
        LD      A,(TRIXB+1)
        CP      B
        JR      C,FILLSPANSWAP
        LD      C,A
        JR      FILLSPANCLIP
FILLSPANSWAP:
        LD      C,B
        LD      B,A
FILLSPANCLIP:
        LD      A,B
        BIT     7,A
        JR      Z,FILLSPANHI
        LD      B,0
FILLSPANHI:
        LD      A,C
        CP      255
        JR      C,FILLSPANGO
        LD      C,255
FILLSPANGO:
        JR      FILLRANGE

; Fill pixels from B (low) to C (high) inclusive at scanline E.
FILLRANGE:
        LD      D,B
FILLRANGEPIX:
        LD      A,C
        CP      D
        JR      C,FILLRANGEDONE
        PUSH    BC
        PUSH    DE
        LD      B,D
        LD      C,E
        CALL    FILLPIXEL
        POP     DE
        POP     BC
        INC     D
        JR      FILLRANGEPIX
FILLRANGEDONE:
        RET

; Fixed-point 8.8 slope for a triangle edge: D = signed x span, E = positive
; y span. Returns HL = (D*256)/E.
FIXSLOPE:
        LD      H,D
        LD      L,0
        JR      SDIV16

; Signed 16-bit HL divided by the positive byte E. Returns the quotient in
; HL, truncated toward zero. Clobbers A, B, D, E.
SDIV16: BIT     7,H
        JR      Z,SDIVU
        XOR     A
        SUB     L
        LD      L,A
        LD      A,0
        SBC     A,H
        LD      H,A
        CALL    SDIVU
        XOR     A
        SUB     L
        LD      L,A
        LD      A,0
        SBC     A,H
        LD      H,A
        RET
SDIVU:  LD      B,16
        XOR     A
SDIVULOOP:
        ADD     HL,HL
        ADC     A,A
        CP      E
        JR      C,SDIVUNEXT
        SUB     E
        INC     L
SDIVUNEXT:
        DJNZ    SDIVULOOP
        RET

; PSG and controller BIOS entry points and the VDP interrupt counter.
WRTPSG  EQU     0093H
RDPSG   EQU     0096H
GTSTCK  EQU     00D5H
GTTRIG  EQU     00D8H
JIFFY   EQU     0FC9EH

; Remaining optional facilities retain the imported port's explicit error.
; Text colour, envelope shaping, and the IMS clock are later slices.
COLOUR:
ENVEL:
GETIMS:
PUTIMS:
        XOR     A
        CALL    EXTERR
        DEFM    'Sorry'
        DEFB    0

; SOUND channel, amplitude, pitch, duration
;   channel  0 = noise, 1-3 = tone A/B/C.
;   amplitude 0..-15 (0 = off, -15 = loudest).
;   pitch    0-255, higher is lower frequency.
;   duration in twentieths of a second: 0 plays indefinitely, a positive
;   value plays synchronously and then silences the channel.
; The BBC logarithmic pitch scale is approximated by a linear PSG period;
; timing is a JIFFY-based synchronous wait.
SOUND:  CALL    EXPRI
        EXX
        PUSH    HL              ; channel
        CALL    COMMA
        CALL    EXPRI
        EXX
        PUSH    HL              ; amplitude
        CALL    COMMA
        CALL    EXPRI
        EXX
        PUSH    HL              ; pitch
        CALL    COMMA
        CALL    EXPRI
        EXX
        POP     DE              ; pitch
        POP     BC              ; amplitude
        EX      (SP),HL         ; HL = channel, stack = duration

        LD      A,H
        OR      A
        JP      NZ,SOUNDBAD
        LD      A,L
        CP      4
        JP      NC,SOUNDBAD
        PUSH    AF              ; save channel

        ; Amplitude -> PSG volume 0-15 in B.
        LD      A,B
        OR      A
        JR      NZ,SOUNDNEG
        XOR     A               ; amplitude >= 0 -> off
        JR      SOUNDVOL
SOUNDNEG:
        XOR     A
        SUB     C
        CP      16
        JR      C,SOUNDVOL
        LD      A,15
SOUNDVOL:
        LD      B,A

        ; Pitch -> 12-bit PSG period in HL ((pitch+1)*16, clamped to 4095).
        LD      A,D
        OR      A
        JR      NZ,SOUNDPCLAMP
        LD      L,E
        LD      H,0
        INC     HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        LD      A,H
        CP      10H
        JR      NZ,SOUNDPOK
SOUNDPCLAMP:
        LD      HL,0FFFH
SOUNDPOK:

        POP     AF              ; A = channel
        OR      A
        JR      Z,SOUNDNOISE

        ; Tone channel (A = 1..3): period low/high and volume.
        DEC     A               ; A = 0..2
        LD      C,A
        ADD     A,8             ; volume register (8,9,10)
        LD      (SOUNDREG),A
        LD      E,B
        CALL    WRTPSG
        LD      A,C
        ADD     A,A             ; low period register (0,2,4)
        LD      E,L
        CALL    WRTPSG
        INC     A               ; high period register (1,3,5)
        LD      E,H
        CALL    WRTPSG
        JR      SOUNDDUR

        ; Noise channel: route noise onto channel A, write period and volume.
SOUNDNOISE:
        ; A = 0 (channel), B = volume, E = pitch (low byte).
        LD      A,E
        SRL     A
        SRL     A
        SRL     A               ; noise period = pitch >> 3 (0-31)
        LD      E,A
        LD      A,6
        CALL    WRTPSG          ; noise period R6
        LD      A,8
        LD      (SOUNDREG),A
        LD      E,B
        CALL    WRTPSG          ; volume R8
        LD      A,7
        CALL    RDPSG
        SET     0,A             ; tone A off
        RES     3,A             ; noise A on
        LD      E,A
        LD      A,7
        CALL    WRTPSG          ; mixer R7

SOUNDDUR:
        POP     DE              ; duration
        LD      A,D
        OR      A
        JR      NZ,SOUNDXEQ     ; >255 -> leave playing
        LD      A,E
        OR      A
        JR      Z,SOUNDXEQ      ; 0 -> indefinite
        ; Wait duration*3 JIFFY ticks (about 50 ms per twentieth at 60 Hz).
        LD      L,E
        LD      H,0
        LD      B,H
        LD      C,L
        ADD     HL,HL
        ADD     HL,BC
        LD      B,H
        LD      C,L             ; BC = target ticks
        LD      DE,(JIFFY)      ; DE = start
SOUNDWAIT:
        LD      HL,(JIFFY)
        OR      A
        SBC     HL,DE
        OR      A
        SBC     HL,BC
        JR      C,SOUNDWAIT
        LD      A,(SOUNDREG)
        LD      E,0
        CALL    WRTPSG          ; silence the channel
        JP      XEQ

SOUNDXEQ:
        JP      XEQ

SOUNDBAD:
        XOR     A
        CALL    EXTERR
        DEFM    'Sound argument out of range'
        DEFB    0

; ADVAL(n): read the controller state.
;   0/2 = joystick 1/2 direction (0-8), 1/3 = trigger 1/2 (0 or -1),
;   otherwise 0. A digital approximation of the BBC analogue channels.
ADVAL:  CALL    EXPRI
        EXX
        PUSH    HL
        CALL    BRAKET
        POP     HL
        LD      A,H
        OR      A
        JR      NZ,ADVALZERO
        LD      A,L
        CP      4
        JR      NC,ADVALZERO
        BIT     0,A
        JR      Z,ADVALSTICK
        SRL     A               ; n=1 -> 0, n=3 -> 1
        INC     A               ; selector 1 or 2
        CALL    GTTRIG
        JR      ADVALRET
ADVALSTICK:
        SRL     A               ; n=0 -> 0, n=2 -> 1
        INC     A               ; selector 1 or 2
        CALL    GTSTCK
        JR      ADVALRET
ADVALZERO:
        XOR     A
ADVALRET:
        LD      L,A
        LD      H,0
        EXX
        XOR     A
        LD      C,A
        LD      H,A
        LD      L,A
        RET

FIN:    END
