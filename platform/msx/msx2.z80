; SPDX-License-Identifier: BSD-3-Clause
;
; MSX2 (V9938/V9958) bitmap pixel primitives for the BBC BASIC adapter.
; Screens 5 (4bpp) and 7/8 (8bpp) live here; Screen 6 (2bpp, 512-wide) is
; implemented in the graphics module because this ROM gap is exhausted. This
; module is linked into the ROM gap between the sprite module and the language
; core.

        TITLE   BBC BASIC MSX2 PIXEL ADAPTER

        GLOBAL  M2PIX
        GLOBAL  M2RDP
        GLOBAL  M2RMW

        EXTRN   GRAPHCOLOUR
        EXTRN   PIXELMODE
        EXTRN   CURMODE
        EXTRN   M2P6
        EXTRN   M2RD6

RDVRM   EQU     004AH
WRTVRM  EQU     004DH

; MSX2 bitmap pixel write. B=x, C=y, E=colour (0-15). Uses PIXELMODE (0=set,
; 1=xor, 2=clear) and CURMODE (5-8).
M2PIX:
        LD      A,(CURMODE)
        CP      6
        JP      Z,M2P6    ; Screen 6 (2bpp, in graphics module)
        CP      7
        JR      NC,MSX2_PIXEL8
        ; Screen 5 (4bpp): addr = y*128 + x/2.
        LD      L,C
        LD      H,0
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL           ; HL = y*128
        LD      A,B
        SRL     A               ; x/2
        OR      L
        LD      L,A             ; HL = y*128 + x/2
        LD      A,B
        AND     1
        JR      NZ,MSX2_PIXEL5_LOW
        ; High nibble: colour << 4, preserve the low nibble.
        LD      A,E
        RLCA
        RLCA
        RLCA
        RLCA
        AND     0F0H
        LD      D,A             ; D = colour nibble
        LD      A,0FH
        JR      M2RMW
MSX2_PIXEL5_LOW:
        LD      A,E
        AND     0FH
        LD      D,A             ; D = colour nibble
        LD      A,0F0H

; Shared read-modify-write. A = preserve mask, D = colour byte, HL = address.
M2RMW:
        LD      B,A             ; B = preserve mask
        CALL    RDVRM           ; A = byte, HL preserved
        PUSH    AF              ; save byte
        LD      A,(PIXELMODE)
        CP      2
        JR      Z,MSX2_RMW_CLR
        CP      1
        JR      Z,MSX2_RMW_XOR
        POP     AF              ; set
        AND     B
        OR      D
        JR      MSX2_RMW_WR
MSX2_RMW_CLR:
        POP     AF
        AND     B
        JR      MSX2_RMW_WR
MSX2_RMW_XOR:
        POP     AF
        XOR     D
MSX2_RMW_WR:
        CALL    WRTVRM
        RET

; Screen 7/8 (8bpp): addr = y*256 + x.
MSX2_PIXEL8:
        LD      H,C             ; H = y
        LD      L,B             ; L = x -> HL = y*256 + x
        LD      A,(PIXELMODE)
        CP      2
        JR      Z,MSX2_PIXEL8_CLR
        CP      1
        JR      Z,MSX2_PIXEL8_XOR
        LD      A,E             ; set
        CALL    WRTVRM
        RET
MSX2_PIXEL8_CLR:
        XOR     A
        CALL    WRTVRM
        RET
MSX2_PIXEL8_XOR:
        CALL    RDVRM
        XOR     E
        CALL    WRTVRM
        RET

; MSX2 bitmap pixel read. B=x, C=y. Returns the colour (0-15) in A.
M2RDP:
        LD      A,(CURMODE)
        CP      6
        JP      Z,M2RD6 ; Screen 6 (2bpp, in graphics module)
        CP      7
        JR      NC,MSX2_READPIXEL8
        ; Screen 5 (4bpp): addr = y*128 + x/2.
        LD      L,C
        LD      H,0
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL
        LD      A,B
        SRL     A
        OR      L
        LD      L,A
        CALL    RDVRM           ; A = byte
        LD      D,A
        LD      A,B
        AND     1
        JR      NZ,MSX2_READ5_LOW
        LD      A,D
        RLCA
        RLCA
        RLCA
        RLCA
        AND     0FH
        RET
MSX2_READ5_LOW:
        LD      A,D
        AND     0FH
        RET
MSX2_READPIXEL8:
        LD      H,C
        LD      L,B
        CALL    RDVRM
        RET

FIN:    END
