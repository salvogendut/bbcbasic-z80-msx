; SPDX-License-Identifier: BSD-3-Clause
;
; MSX2 (V9938/V9958) bitmap pixel primitives for the BBC BASIC adapter.
; Screens 5/7 (4bpp) and 8 (8bpp) live here; Screen 6 (2bpp) is implemented
; in the graphics module because this ROM gap is exhausted. This module is
; linked into the ROM gap between the sprite module and the language core.

        TITLE   BBC BASIC MSX2 PIXEL ADAPTER

        GLOBAL  M2PIX
        GLOBAL  M2RDP
        GLOBAL  M2RMW

        EXTRN   GRAPHCOLOUR
        EXTRN   PIXELMODE
        EXTRN   CURMODE
        EXTRN   M2P6
        EXTRN   M2RD6
        EXTRN   M2RDV
        EXTRN   M2WRV

; MSX2 bitmap pixel write. B=x, C=y, E=colour (0-15). Uses PIXELMODE (0=set,
; 1=xor, 2=clear) and CURMODE (5-8).
M2PIX:
        LD      A,(CURMODE)
        CP      6
        JP      Z,M2P6    ; Screen 6 (2bpp, in graphics module)
        CP      8
        JR      NC,MSX2_PIXEL8
        ; Screen 5: y*128+x/2. Screen 7: y*256+x/2 (left 256 pixels).
        LD      H,C
        LD      L,0
        CP      7
        JR      Z,MSX2_PIXEL47_ADDR
        SRL     H
        RR      L               ; HL = y*128 for Screen 5
MSX2_PIXEL47_ADDR:
        LD      A,B
        SRL     A               ; x/2
        OR      L
        LD      L,A             ; HL = y*128 + x/2
        LD      A,B
        AND     1
        JR      NZ,MSX2_PIXEL5_LOW
        ; High nibble: colour << 4, preserve the low nibble.
        LD      A,E
        RLCA
        RLCA
        RLCA
        RLCA
        AND     0F0H
        LD      D,A             ; D = colour nibble
        LD      A,0FH
        JR      M2RMW
MSX2_PIXEL5_LOW:
        LD      A,E
        AND     0FH
        LD      D,A             ; D = colour nibble
        LD      A,0F0H

; Shared read-modify-write. A = preserve mask, D = colour byte, HL = address.
M2RMW:
        LD      B,A             ; B = preserve mask
        CALL    M2RDV           ; A = byte, HL preserved
        PUSH    AF              ; save byte
        LD      A,(PIXELMODE)
        CP      2
        JR      Z,MSX2_RMW_CLR
        CP      1
        JR      Z,MSX2_RMW_XOR
        POP     AF              ; set
        AND     B
        OR      D
        JR      MSX2_RMW_WR
MSX2_RMW_CLR:
        POP     AF
        AND     B
        JR      MSX2_RMW_WR
MSX2_RMW_XOR:
        POP     AF
        XOR     D
MSX2_RMW_WR:
        CALL    M2WRV
        RET

; Screen 8 (8bpp): addr = y*256 + x.
MSX2_PIXEL8:
        LD      H,C             ; H = y
        LD      L,B             ; L = x -> HL = y*256 + x
        LD      A,(PIXELMODE)
        CP      2
        JR      Z,MSX2_PIXEL8_CLR
        CP      1
        JR      Z,MSX2_PIXEL8_XOR
        LD      A,E             ; set
        CALL    M2WRV
        RET
MSX2_PIXEL8_CLR:
        XOR     A
        CALL    M2WRV
        RET
MSX2_PIXEL8_XOR:
        CALL    M2RDV
        XOR     E
        CALL    M2WRV
        RET

; MSX2 bitmap pixel read. B=x, C=y. Returns the colour (0-15) in A.
M2RDP:
        LD      A,(CURMODE)
        CP      6
        JP      Z,M2RD6 ; Screen 6 (2bpp, in graphics module)
        CP      8
        JR      NC,MSX2_READPIXEL8
        LD      H,C
        LD      L,0
        CP      7
        JR      Z,MSX2_READ47_ADDR
        SRL     H
        RR      L
MSX2_READ47_ADDR:
        LD      A,B
        SRL     A
        OR      L
        LD      L,A
        CALL    M2RDV           ; A = byte
        LD      D,A
        LD      A,B
        AND     1
        JR      NZ,MSX2_READ5_LOW
        LD      A,D
        RLCA
        RLCA
        RLCA
        RLCA
        AND     0FH
        RET
MSX2_READ5_LOW:
        LD      A,D
        AND     0FH
        RET
MSX2_READPIXEL8:
        LD      H,C
        LD      L,B
        CALL    M2RDV
        RET

FIN:    END
