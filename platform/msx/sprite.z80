; SPDX-License-Identifier: BSD-3-Clause
;
; MSX hardware sprite commands, dispatched from the OSCLI hook.
; Sprites use the fixed Screen 2 (Graphics II) table layout and are visible
; only after MODE 2. Commands are case-insensitive and comma-separated.
;
; This module is linked into the ROM gap between the console adapter and the
; BBC language core so the graphics adapter retains room for MSX2 work.

        TITLE   BBC BASIC MSX SPRITE ADAPTER

        GLOBAL  SPRITECMD

WRTVRM  EQU     004DH
ATRBASE EQU     1B00H
PATBASE EQU     3800H
SPROFF  EQU     0D1H

; Entry from OSCLI: HL -> CR-terminated command (after '*'). Returns carry set
; if a sprite command was handled, carry clear otherwise.
SPRITECMD:
        CALL    SKIPSPACE
        CALL    MATCHSPRITE
        RET     NC
        ; HL now points after "SPRITE".
        LD      A,(HL)
        AND     5FH             ; uppercase
        CP      'O'
        JR      Z,SPRITEOFFCMD
        CP      'P'
        JR      Z,SPRITEPATCMD
        CP      'C'
        JP      Z,SPRITECLRCMD
        ; *SPRITE n,x,y,pattern,colour
        CALL    SKIPSPACE
        CALL    PARSENUM        ; n
        PUSH    AF
        CALL    SKIPCOMMA
        CALL    PARSENUM        ; x
        PUSH    AF
        CALL    SKIPCOMMA
        CALL    PARSENUM        ; y
        PUSH    AF
        CALL    SKIPCOMMA
        CALL    PARSENUM        ; pattern
        PUSH    AF
        CALL    SKIPCOMMA
        CALL    PARSENUM        ; colour
        LD      E,A             ; E = colour
        POP     AF              ; pattern
        LD      D,A             ; D = pattern
        POP     AF              ; y
        LD      C,A             ; C = y
        POP     AF              ; x
        LD      B,A             ; B = x
        POP     AF              ; A = n
        ; attribute address = ATRBASE + n*4
        LD      H,0
        LD      L,A             ; HL = n
        ADD     HL,HL
        ADD     HL,HL
        PUSH    DE              ; save pattern (D) and colour (E)
        LD      DE,ATRBASE
        ADD     HL,DE           ; HL = attribute address
        POP     DE              ; restore pattern and colour
        LD      A,C             ; Y
        CALL    WRTVRM
        INC     HL
        LD      A,B             ; X
        CALL    WRTVRM
        INC     HL
        LD      A,D             ; pattern
        CALL    WRTVRM
        INC     HL
        LD      A,E             ; colour
        CALL    WRTVRM
        SCF
        RET

; *SPRITEOFF n: hide sprite n (Y = 209).
SPRITEOFFCMD:
        INC     HL              ; skip O
        INC     HL              ; skip F
        INC     HL              ; skip F
        CALL    SKIPSPACE
        CALL    PARSENUM        ; n
        LD      H,0
        LD      L,A
        ADD     HL,HL
        ADD     HL,HL
        LD      DE,ATRBASE
        ADD     HL,DE
        LD      A,SPROFF
        CALL    WRTVRM
        SCF
        RET

; *SPRITEPAT n,b0,b1,b2,b3,b4,b5,b6,b7: define the 8 bytes of pattern n.
SPRITEPATCMD:
        INC     HL              ; skip P
        INC     HL              ; skip A
        INC     HL              ; skip T
        CALL    SKIPSPACE
        CALL    PARSENUM        ; n
        PUSH    HL              ; save string pointer
        LD      H,0
        LD      L,A
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,HL           ; n*8
        LD      DE,PATBASE
        ADD     HL,DE
        EX      DE,HL           ; DE = pattern VRAM address
        POP     HL              ; HL = string pointer
        LD      B,8
SPRITEPAT_LOOP:
        CALL    SKIPCOMMA
        PUSH    BC
        CALL    PARSENUM        ; A = byte, HL advanced
        EX      DE,HL           ; HL = pattern VRAM address
        CALL    WRTVRM
        EX      DE,HL           ; HL = string pointer
        INC     DE              ; next VRAM byte
        POP     BC
        DJNZ    SPRITEPAT_LOOP
        SCF
        RET

; *SPRITECLR: hide all 32 sprites.
SPRITECLRCMD:
        INC     HL              ; skip C
        INC     HL              ; skip L
        INC     HL              ; skip R
        LD      HL,ATRBASE
        LD      B,32
SPRITECLR_LOOP:
        LD      A,SPROFF        ; Y = 209
        CALL    WRTVRM
        INC     HL
        XOR     A               ; X, pattern, colour = 0 (A preserved by WRTVRM)
        CALL    WRTVRM
        INC     HL
        CALL    WRTVRM
        INC     HL
        CALL    WRTVRM
        INC     HL
        DJNZ    SPRITECLR_LOOP
        SCF
        RET

; Advance HL past a leading space.
SKIPSPACE:
        LD      A,(HL)
        CP      ' '
        RET     NZ
        INC     HL
        RET

; Advance HL past a comma and an optional following space.
SKIPCOMMA:
        INC     HL
        LD      A,(HL)
        CP      ' '
        RET     NZ
        INC     HL
        RET

; Match "SPRITE" (case-insensitive) at (HL). On success advance HL past it and
; return carry set; on failure leave HL unchanged and return carry clear.
MATCHSPRITE:
        PUSH    HL
        LD      B,6
        LD      DE,NAME_SPRITE
MATCHSPRITE_LOOP:
        LD      A,(DE)
        INC     DE
        LD      C,A
        LD      A,(HL)
        AND     5FH             ; uppercase
        CP      C
        JR      NZ,MATCHSPRITE_FAIL
        INC     HL
        DJNZ    MATCHSPRITE_LOOP
        POP     AF
        SCF
        RET
MATCHSPRITE_FAIL:
        POP     HL
        OR      A
        RET

NAME_SPRITE:
        DEFM    'SPRITE'

; Parse a decimal byte at (HL), advancing HL past the digits. Returns the
; value (0-255) in A. Clobbers A and BC; preserves DE.
PARSENUM:
        LD      C,0
PARSENUM_LOOP:
        LD      A,(HL)
        SUB     '0'
        CP      10
        JR      NC,PARSENUM_DONE
        PUSH    AF
        LD      A,C
        ADD     A,A
        LD      B,A
        ADD     A,A
        ADD     A,A
        ADD     A,B
        POP     BC
        ADD     A,B
        LD      C,A
        INC     HL
        JR      PARSENUM_LOOP
PARSENUM_DONE:
        LD      A,C
        RET

FIN:    END
