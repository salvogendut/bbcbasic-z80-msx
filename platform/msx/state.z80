;
; Writable state used by the MSX adapter.

        TITLE   BBC BASIC MSX ADAPTER STATE

        GLOBAL  PSTBASE
        GLOBAL  PSTEND
        GLOBAL  TIMEOFF
        GLOBAL  PENDKEY
        GLOBAL  PENDVAL
        GLOBAL  ESCFLAG
        GLOBAL  TRAPCNT
        GLOBAL  GRAPHX
        GLOBAL  GRAPHY
        GLOBAL  GRAPHCOLOUR
        GLOBAL  TARGETX
        GLOBAL  TARGETY
        GLOBAL  DELTAX
        GLOBAL  DELTAY
        GLOBAL  STEPX
        GLOBAL  STEPY
        GLOBAL  LINEERR
        GLOBAL  TAPENAME
        GLOBAL  TAPEMETA
        GLOBAL  TAPEADDRESS
        GLOBAL  TAPECOUNT

PSTBASE:
TIMEOFF:        DEFS    4
PENDKEY:        DEFS    1
PENDVAL:        DEFS    1
ESCFLAG:        DEFS    1
TRAPCNT:        DEFS    1
GRAPHX:         DEFS    1
GRAPHY:         DEFS    1
GRAPHCOLOUR:    DEFS    1
TARGETX:        DEFS    1
TARGETY:        DEFS    1
DELTAX:         DEFS    1
DELTAY:         DEFS    1
STEPX:          DEFS    1
STEPY:          DEFS    1
LINEERR:        DEFS    1
TAPENAME:       DEFS    6
TAPEMETA:       DEFS    6
TAPEADDRESS:    DEFS    2
TAPECOUNT:      DEFS    2
PSTEND:

FIN:    END
